@model List<ProjectTracker.Models.Models.DTOs.Sprint.SprintSummaryDTO>
@{ ViewData["Title"] = "Sprints"; }
<h1 class="page-title">Sprints</h1>
<div class="panel">
    <table class="table table-dark-custom">
        <thead><tr><th>Sprint</th><th>Project</th><th>Status</th><th>Progress</th><th>Dates</th><th></th></tr></thead>
        <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.SprintName</td><td>@s.ProjectName</td><td>@s.Status</td>
                <td><div class="progress" style="height:6px;width:120px;"><div class="progress-bar" style="width:@s.Progress%"></div></div></td>
                <td>@s.StartDate.ToShortDateString() - @s.EndDate.ToShortDateString()</td>
                <td><a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-primary">Details</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
