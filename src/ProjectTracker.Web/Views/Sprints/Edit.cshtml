@model ProjectTracker.Models.Models.DTOs.Sprint.EditSprintDTO
@{ ViewData["Title"] = "Edit Sprint"; }
<h1 class="page-title">Edit Sprint</h1>
<div class="panel">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ProjectId" />
        <div class="mb-3"><label asp-for="SprintName" class="form-label"></label><input asp-for="SprintName" class="form-control" /></div>
        <div class="row">
            <div class="col-md-4 mb-3"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" type="date" class="form-control" /></div>
            <div class="col-md-4 mb-3"><label asp-for="EndDate" class="form-label"></label><input asp-for="EndDate" type="date" class="form-control" /></div>
            <div class="col-md-4 mb-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ProjectTracker.Models.Models.Entities.SprintStatus>()"></select></div>
        </div>
        <button class="btn btn-primary" type="submit">Save</button>
        <a class="btn btn-outline-light" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
    </form>
</div>
