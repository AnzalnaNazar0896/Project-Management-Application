@model ProjectTracker.Models.Models.DTOs.Sprint.SprintDetailsDTO
@{ ViewData["Title"] = Model.SprintName; }
<h1 class="page-title">@Model.SprintName</h1>
<div class="panel mb-3">
    <p><strong>Project:</strong> @Model.ProjectName | <strong>Status:</strong> @Model.Status</p>
    <p>@Model.StartDate.ToShortDateString() — @Model.EndDate.ToShortDateString()</p>
    <div class="progress" style="height:10px;"><div class="progress-bar" style="width:@Model.Progress%"></div></div>
    <small>@Model.Progress% complete</small>
</div>
<div class="panel">
    <h5>Sprint Tasks</h5>
    <table class="table table-dark-custom table-sm">
        <thead><tr><th>Title</th><th>Status</th><th>Priority</th><th>Due</th></tr></thead>
        <tbody>
        @foreach (var t in Model.Tasks)
        {
            <tr><td><a asp-controller="Tasks" asp-action="Details" asp-route-id="@t.Id">@t.Title</a></td><td>@t.Status</td><td>@t.Priority</td><td>@t.DueDate.ToShortDateString()</td></tr>
        }
        </tbody>
    </table>
</div>
