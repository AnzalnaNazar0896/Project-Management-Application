@model List<ProjectTracker.Models.Models.DTOs.Team.TeamMemberListItemDTO>
@{
    ViewData["Title"] = "Team";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">Team</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-person-plus"></i> New team member</a>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<div class="panel">
    <table class="table table-dark table-dark-custom mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Department</th>
                <th>Role</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var m in Model)
            {
                <tr>

                    <td>
                        <strong>@m.Name</strong>
                    </td>

                    <td>
                        @m.Email
                    </td>

                    <td>
                        @(m.Department ?? "—")
                    </td>

                    <td>

                        @if (m.Projects != null && m.Projects.Any())
                        {
                            <div class="project-tags">

                                @foreach (var project in m.Projects)
                                {
                                    <span class="project-tag">
                                        @project
                                    </span>
                                }

                            </div>
                        }
                        else
                        {
                            <span class="text-muted">No projects</span>
                        }

                    </td>

                    <td class="text-end">

                        <a asp-action="Edit"
                           asp-route-id="@m.EmployeeId"
                           class="btn btn-sm btn-outline-light">

                            <i class="bi bi-pencil"></i>
                           
                        </a>

                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>
