@model ProjectTracker.Models.Models.DTOs.Task.TaskDetailsDTO
@{ ViewData["Title"] = Model.Title; var canUpdate = (bool)(ViewBag.CanUpdateStatus ?? false); var canEdit = (bool)(ViewBag.CanEdit ?? false); }
<div class="d-flex justify-content-between align-items-center mb-2">
    <h1 class="page-title mb-0">@Model.Title</h1>
    @if (canEdit)
    {
        <div class="d-flex gap-2">
            <a class="btn btn-sm btn-outline-light" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
            <form asp-action="Delete" method="post" onsubmit="return confirm('Delete this task?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
            </form>
        </div>
    }
</div>
<div class="row g-3">
    <div class="col-lg-8">
        <div class="panel">
            <p>@Model.Description</p>
            <p><strong>Project:</strong> <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId">@Model.ProjectName</a></p>
            <p><strong>Board:</strong> <a asp-controller="Boards" asp-action="Kanban" asp-route-id="@Model.BoardId">@Model.BoardName</a></p>
            <p><strong>Sprint:</strong> @Model.SprintName</p>
            <p><strong>Assigned:</strong> @Model.AssignedTo</p>
            <p><strong>Due:</strong> @Model.DueDate.ToShortDateString()</p>
            @if (canUpdate)
            {
                <form asp-action="UpdateStatus" method="post" class="d-flex gap-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div>
                        <label class="form-label">Update Status</label>
                        <select name="status" class="form-select">
                            @foreach (var s in Enum.GetValues<ProjectTracker.Models.Models.Enums.TaskStatus>())
                            {
                                <option value="@s" selected="@(Model.Status == s.ToString())">@s</option>
                            }
                        </select>
                    </div>
                    <button class="btn btn-primary" type="submit">Update</button>
                </form>
            }
        </div>
        <div class="panel">
            <h5>Comments</h5>
            @foreach (var c in Model.Comments)
            {
                <div class="mb-2"><strong>@c.CreatedBy</strong> <small class="text-muted">@c.CreatedDate</small><br />@c.Message</div>
            }
            <form asp-action="AddComment" method="post" class="mt-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="taskId" value="@Model.Id" />
                <textarea name="message" class="form-control mb-2" rows="2" required></textarea>
                <button class="btn btn-sm btn-primary" type="submit">Add Comment</button>
            </form>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="panel">
            <h5>Attachments</h5>
            <ul class="mb-3">
                @foreach (var a in Model.Attachments)
                {
                    <li><a href="@a.FilePath" target="_blank">@a.FileName</a></li>
                }
            </ul>
            <form asp-action="UploadAttachment" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="taskId" value="@Model.Id" />
                <input type="file" name="file" class="form-control mb-2" required />
                <button class="btn btn-sm btn-primary" type="submit">Upload</button>
            </form>
        </div>
    </div>
</div>
