@model List<ProjectTracker.Models.Models.DTOs.Task.TaskSummaryDTO>
@{ ViewData["Title"] = "Tasks"; var filter = ViewBag.StatusFilter as string; }
<h1 class="page-title">Tasks @(filter != null ? $"({filter})" : "")</h1>
<div class="panel">
    <table class="table table-dark-custom">
        <thead><tr><th>Title</th><th>Project</th><th>Board</th><th>Status</th><th>Priority</th><th>Assigned</th><th>Due</th></tr></thead>
        <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@t.Id">@t.Title</a></td>
                <td>@t.ProjectName</td><td>@t.BoardName</td><td><span class="badge bg-secondary">@t.Status</span></td>
                <td>@t.Priority</td><td>@t.AssignedTo</td><td>@t.DueDate.ToShortDateString()</td>
            </tr>
        }
        </tbody>
    </table>
</div>
