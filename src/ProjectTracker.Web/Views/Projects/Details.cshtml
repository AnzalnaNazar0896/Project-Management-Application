@model ProjectTracker.Models.Models.DTOs.Project.ProjectDetailsDTO
@{
    ViewData["Title"] = Model.ProjectName;
    var canManage = (bool)(ViewBag.CanManage ?? false);
    var canEdit = (bool)(ViewBag.CanEditProject ?? false);
}
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="page-title mb-1">@Model.ProjectName</h1>
        <p class="text-muted mb-0">@Model.Description</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (canEdit) { <a class="btn btn-outline-light btn-sm" asp-action="Edit" asp-route-id="@Model.Id">Edit Project</a> }
        @if (canManage)
        {
            <a class="btn btn-outline-light btn-sm" asp-controller="Boards" asp-action="Create" asp-route-projectId="@Model.Id">Add Board</a>
            <a class="btn btn-outline-light btn-sm" asp-controller="Sprints" asp-action="Create" asp-route-projectId="@Model.Id">Add Sprint</a>
            <a class="btn btn-outline-light btn-sm" asp-controller="Tasks" asp-action="Create" asp-route-projectId="@Model.Id">Create Task</a>
            <a class="btn btn-outline-light btn-sm" asp-action="ManageMembers" asp-route-id="@Model.Id">Manage Members</a>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="panel">
            <h5>Project Information</h5>
            <p><strong>Status:</strong> @Model.Status</p>
            <p><strong>Start:</strong> @Model.StartDate?.ToShortDateString()</p>
            <p><strong>End:</strong> @Model.EndDate?.ToShortDateString()</p>
            <p class="mb-2"><strong>Progress</strong></p>
            <div class="progress" style="height:10px;"><div class="progress-bar" style="width:@Model.Progress%"></div></div>
        </div>
        <div class="panel">
            <h5>Task Summary</h5>
            <p>Total: @Model.TotalTasks | Completed: @Model.CompletedTasks | Pending: @Model.PendingTasks | In Progress: @Model.InProgressTasks</p>
        </div>
        <div class="panel">
            <h5>Sprint Summary</h5>
            <p>Total: @Model.TotalSprints | Active: @Model.ActiveSprints | Completed: @Model.CompletedSprints</p>
        </div>
        @if (canManage)
        {
            <div class="panel">
                <h5>Upload Attachment</h5>
                <form asp-controller="Attachments" asp-action="UploadToProject" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="projectId" value="@Model.Id" />
                    @Html.AntiForgeryToken()
                    <input type="file" name="file" class="form-control mb-2" required />
                    <button class="btn btn-sm btn-primary" type="submit">Upload</button>
                </form>
            </div>
        }
    </div>
    <div class="col-lg-8">
        <div class="panel">
            <h5>Members</h5>
            <table class="table table-dark-custom table-sm">
                <thead><tr><th>Name</th><th>Role</th><th>Assigned</th><th>Completed</th><th>Pending</th><th>Availability</th></tr></thead>
                <tbody>
                @foreach (var m in Model.Members)
                {
                    <tr>
                        <td>@m.Name</td><td>@m.Role</td><td>@m.AssignedTasks</td><td>@m.CompletedTasks</td><td>@m.PendingTasks</td><td>@m.Availability</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="panel">
            <h5>Boards</h5>
            @foreach (var b in Model.Boards)
            {
                <a class="badge bg-secondary me-1 mb-1 text-decoration-none" asp-controller="Boards" asp-action="Kanban" asp-route-id="@b.Id">@b.BoardName (@b.TaskCount)</a>
            }
        </div>
        <div class="panel">
            <h5>Tasks</h5>
            <table class="table table-dark-custom table-sm">
                <thead><tr><th>Title</th><th>Status</th><th>Priority</th><th>Due</th></tr></thead>
                <tbody>
                @foreach (var t in Model.Tasks.Take(10))
                {
                    <tr><td><a asp-controller="Tasks" asp-action="Details" asp-route-id="@t.Id">@t.Title</a></td><td>@t.Status</td><td>@t.Priority</td><td>@t.DueDate.ToShortDateString()</td></tr>
                }
                </tbody>
            </table>
        </div>
        <div class="panel">
            <h5>Attachments</h5>
            <ul>
                @foreach (var a in Model.Attachments)
                {
                    <li><a href="@a.FilePath" target="_blank">@a.FileName</a> <small class="text-muted">by @a.UploadedBy</small></li>
                }
            </ul>
        </div>
        <div class="panel">
            <h5>Recent Notifications</h5>
            @foreach (var n in Model.RecentNotifications)
            {
                <div class="mb-2"><strong>@n.Title</strong> — @n.Message</div>
            }
        </div>
    </div>
</div>
