@model ProjectTracker.Models.Models.DTOs.Project.EditProjectDTO
@{ ViewData["Title"] = "Edit Project"; }
<h1 class="page-title">Edit Project</h1>
<div class="panel">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3"><label asp-for="ProjectName" class="form-label"></label><input asp-for="ProjectName" class="form-control" /></div>
        <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4"></textarea></div>
        <div class="row">
            <div class="col-md-3 mb-3"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" type="date" class="form-control" /></div>
            <div class="col-md-3 mb-3"><label asp-for="EndDate" class="form-label"></label><input asp-for="EndDate" type="date" class="form-control" /></div>
            <div class="col-md-3 mb-3"><label asp-for="Status" class="form-label"></label><input asp-for="Status" class="form-control" /></div>
            <div class="col-md-3 mb-3"><label asp-for="Progress" class="form-label"></label><input asp-for="Progress" class="form-control" /></div>
        </div>
        <div class="form-check mb-3"><input asp-for="IsCompleted" class="form-check-input" /><label asp-for="IsCompleted" class="form-check-label"></label></div>
        <button class="btn btn-primary" type="submit">Save</button>
        <a class="btn btn-outline-light" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
    </form>
</div>
