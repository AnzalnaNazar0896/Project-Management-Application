@model List<ProjectTracker.Models.Models.DTOs.Project.ProjectSummaryDTO>
@{
    ViewData["Title"] = "Projects";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">Projects</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> New Project</a>
</div>
<div class="row g-3">
@foreach (var p in Model)
{
    <div class="col-md-6 col-lg-4">
        <div class="panel h-100">
            <h5><a asp-action="Details" asp-route-id="@p.Id">@p.ProjectName</a></h5>
            <span class="badge @(p.IsCompleted ? "bg-success" : "bg-info")">@p.Status</span>
            <div class="progress mt-3" style="height:8px;">
                <div class="progress-bar" style="width:@p.Progress%"></div>
            </div>
            <small class="text-muted">@p.Progress% complete</small>
        </div>
    </div>
}
</div>
