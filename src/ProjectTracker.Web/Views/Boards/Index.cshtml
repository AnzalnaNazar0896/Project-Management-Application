@model List<ProjectTracker.Models.Models.DTOs.Board.BoardSummaryDTO>
@{ ViewData["Title"] = "Boards"; }
<h1 class="page-title">Boards</h1>
<div class="panel">
    <table class="table table-dark-custom">
        <thead><tr><th>Board</th><th>Project</th><th>Tasks</th><th></th></tr></thead>
        <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td>@b.BoardName</td>
                <td>@b.ProjectName</td>
                <td>@b.TaskCount</td>
                <td><a class="btn btn-sm btn-primary" asp-action="Kanban" asp-route-id="@b.Id">Open Kanban</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
