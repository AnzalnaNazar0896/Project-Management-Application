@model ProjectTracker.Models.Models.DTOs.Board.CreateBoardDTO
@{ ViewData["Title"] = "Create Board"; }
<h1 class="page-title">Create Board</h1>
<div class="panel">
    <form asp-action="Create" method="post">
        <input type="hidden" asp-for="ProjectId" />
        <div class="mb-3"><label asp-for="BoardName" class="form-label"></label><input asp-for="BoardName" class="form-control" /></div>
        <button class="btn btn-primary" type="submit">Create</button>
    </form>
</div>
