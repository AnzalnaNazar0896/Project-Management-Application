@model List<ProjectTracker.Models.Models.DTOs.Attachment.AttachmentDTO>
@{ ViewData["Title"] = "Attachments"; }
<h1 class="page-title">Attachments</h1>
<div class="panel">
    <table class="table table-dark-custom">
        <thead><tr><th>File</th><th>Type</th><th>Uploaded By</th><th>Date</th></tr></thead>
        <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td><a href="@a.FilePath" target="_blank">@a.FileName</a></td>
                <td>@a.FileType</td><td>@a.UploadedBy</td><td>@a.CreatedDate</td>
            </tr>
        }
        </tbody>
    </table>
</div>
