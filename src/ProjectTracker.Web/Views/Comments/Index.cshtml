@model List<ProjectTracker.Models.Models.DTOs.Comment.CommentDTO>
@{ ViewData["Title"] = "Comments"; }
<h1 class="page-title">Comments</h1>
<div class="panel">
    <table class="table table-dark table-dark-custom">
        <thead><tr><th>Author</th><th>Message</th><th>Task</th><th>Date</th></tr></thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.CreatedBy</td><td>@c.Message</td>
                <td><a asp-controller="Tasks" asp-action="Details" asp-route-id="@c.TaskItemId">#@c.TaskItemId</a></td>
                <td>@c.CreatedDate</td>
            </tr>
        }
        </tbody>
    </table>
</div>
