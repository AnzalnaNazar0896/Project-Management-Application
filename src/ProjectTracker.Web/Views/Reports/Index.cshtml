@model ProjectTracker.Models.Models.DTOs.Reports.ReportsViewDTO
@{ ViewData["Title"] = "Reports"; }
<h1 class="page-title">Reports</h1>
<div class="reports-grid">

    <div class="panel report-card">
        <div class="report-header">
            <h5>Project Progress</h5>
        </div>

        <div class="chart-container">
            <canvas id="projectProgress"></canvas>
        </div>
    </div>

    <div class="panel report-card">
        <div class="report-header">
            <h5>Completed vs Pending</h5>
        </div>

        <div class="chart-container doughnut-container">
            <canvas id="completedPending"></canvas>
        </div>
    </div>
    <div class="panel report-card">

        <div class="report-header">
            <h5>Team Availability</h5>
            <span>Current availability of team members</span>
        </div>

        <div class="member-availability">

            @foreach (var member in Model.MemberAvailability)
            {
                var status = member.Availability?.Trim() ?? "Available";

                var statusClass = status.ToLowerInvariant() switch
                {
                    "available" => "available",
                    "busy" => "busy",
                    "unavailable" => "unavailable",
                    "leave" => "leave",
                    _ => "unknown"
                };

                <div class="member-row">

                    <div class="member-name">
                        <i class="bi bi-person-circle"></i>

                        <span>
                            @member.MemberName
                        </span>
                    </div>

                    <span class="availability-status @statusClass">
                        <span class="status-dot"></span>
                        @status
                    </span>

                </div>
            }

        </div>

    </div>
</div>
<div class="panel mt-3">
    <h5>Overdue Tasks</h5>
    <table class="table table-dark table-dark-custom table-sm">
        <thead><tr><th>Task</th><th>Project</th><th>Due</th><th>Assigned</th></tr></thead>
        <tbody>
        @foreach (var t in Model.OverdueTasks)
        {
            <tr><td><a asp-controller="Tasks" asp-action="Details" asp-route-id="@t.Id">@t.Title</a></td><td>@t.ProjectName</td><td>@t.DueDate.ToShortDateString()</td><td>@t.AssignedTo</td></tr>
        }
        </tbody>
    </table>
</div>
@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    const chartDefaults = { responsive: true, plugins: { legend: { labels: { color: '#f8fafc' } } }, scales: { x: { ticks: { color: '#94a3b8' } }, y: { ticks: { color: '#94a3b8' } } } };
           function barChart(id, labels, values) {

            new Chart(document.getElementById(id), {

                type: 'bar',

                data: {
                    labels: labels,

                    datasets: [{
                        label: 'Progress %',
                        data: values,
                        backgroundColor: '#4f80ff',
                        borderRadius: 4,
                        barThickness: 28
                    }]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    plugins: {
                        legend: {
                            labels: {
                                color: '#f8fafc',
                                font: {
                                    size: 11
                                }
                            }
                        }
                    },

                    scales: {
                        x: {
                            ticks: {
                                color: '#94a3b8',
                                font: {
                                    size: 11
                                }
                            }
                        },

                        y: {
                            beginAtZero: true,
                            max: 100,

                            ticks: {
                                color: '#94a3b8',
                                font: {
                                    size: 11
                                }
                            }
                        }
                    }
                }
            });
        }
           function doughnut(id, labels, values) {

            new Chart(document.getElementById(id), {
                type: 'doughnut',

                data: {
                    labels: labels,

                    datasets: [{
                        data: values,

                        backgroundColor: [
                            '#3b82f6',
                            '#10b981'
                        ],

                        borderWidth: 1
                    }]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    cutout: '62%',

                    plugins: {
                        legend: {
                            position: 'bottom',

                            labels: {
                                color: '#f8fafc',
                                boxWidth: 20,
                                padding: 12,
                                font: {
                                    size: 11
                                }
                            }
                        }
                    }
                }
            });
        }
    barChart('projectProgress', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProjectProgress.Select(x => x.Label))), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProjectProgress.Select(x => x.Value))));
    doughnut('completedPending', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CompletedVsPending.Select(x => x.Label))), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CompletedVsPending.Select(x => x.Value))));
        barChart(
            'memberavailability',
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.MemberAvailability.Select(x => x.MemberName)
                )),
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        Model.MemberAvailability.Select(x =>
                                x.Availability == "Available" ? 1 :
                                x.Availability == "Busy" ? 0.5 : 0
                        )
                ))
    );</script>
}
