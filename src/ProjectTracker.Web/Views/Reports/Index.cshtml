@model ProjectTracker.Models.Models.DTOs.Reports.ReportsViewDTO
@{ ViewData["Title"] = "Reports"; }
<h1 class="page-title">Reports</h1>
<div class="row g-3">
    <div class="col-lg-6"><div class="panel"><h5>Project Progress</h5><canvas id="projectProgress"></canvas></div></div>
    <div class="col-lg-6"><div class="panel"><h5>Sprint Progress</h5><canvas id="sprintProgress"></canvas></div></div>
    <div class="col-lg-6"><div class="panel"><h5>Tasks By Status</h5><canvas id="tasksByStatus"></canvas></div></div>
    <div class="col-lg-6"><div class="panel"><h5>Tasks By Priority</h5><canvas id="tasksByPriority"></canvas></div></div>
    <div class="col-lg-6"><div class="panel"><h5>Completed vs Pending</h5><canvas id="completedPending"></canvas></div></div>
    <div class="col-lg-6"><div class="panel"><h5>Members Workload</h5><canvas id="memberWorkload"></canvas></div></div>
</div>
<div class="panel mt-3">
    <h5>Overdue Tasks</h5>
    <table class="table table-dark-custom table-sm">
        <thead><tr><th>Task</th><th>Project</th><th>Due</th><th>Assigned</th></tr></thead>
        <tbody>
        @foreach (var t in Model.OverdueTasks)
        {
            <tr><td><a asp-controller="Tasks" asp-action="Details" asp-route-id="@t.Id">@t.Title</a></td><td>@t.ProjectName</td><td>@t.DueDate.ToShortDateString()</td><td>@t.AssignedTo</td></tr>
        }
        </tbody>
    </table>
</div>
@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    const chartDefaults = { responsive: true, plugins: { legend: { labels: { color: '#f8fafc' } } }, scales: { x: { ticks: { color: '#94a3b8' } }, y: { ticks: { color: '#94a3b8' } } } };
    function barChart(id, labels, values) {
        new Chart(document.getElementById(id), { type: 'bar', data: { labels, datasets: [{ data: values, backgroundColor: '#3b82f6' }] }, options: chartDefaults });
    }
    function doughnut(id, labels, values) {
        new Chart(document.getElementById(id), { type: 'doughnut', data: { labels, datasets: [{ data: values, backgroundColor: ['#3b82f6','#10b981','#f59e0b','#ef4444','#8b5cf6'] }] }, options: { plugins: { legend: { labels: { color: '#f8fafc' } } } } });
    }
    barChart('projectProgress', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProjectProgress.Select(x => x.Label))), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProjectProgress.Select(x => x.Value))));
    barChart('sprintProgress', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SprintProgress.Select(x => x.Label))), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SprintProgress.Select(x => x.Value))));
    doughnut('tasksByStatus', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TasksByStatus.Select(x => x.Label))), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TasksByStatus.Select(x => x.Value))));
    doughnut('tasksByPriority', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TasksByPriority.Select(x => x.Label))), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TasksByPriority.Select(x => x.Value))));
    doughnut('completedPending', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CompletedVsPending.Select(x => x.Label))), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CompletedVsPending.Select(x => x.Value))));
    barChart('memberWorkload', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MemberWorkload.Select(x => x.Label))), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MemberWorkload.Select(x => x.Value))));
</script>
}
